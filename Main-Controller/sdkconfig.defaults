# Custom partition table with a LittleFS storage partition. Recorded here so it
# survives regeneration of sdkconfig.main-controller.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# partitions.csv above needs the full 4 MB (storage alone runs to 0x400000).
# This must live here, not only be assumed from the board default: an earlier
# task deleted sdkconfig.main-controller so the Bluetooth options below would
# take effect, and when it regenerated the flash size silently reverted to the
# 2 MB default, which esptool -t uploadfs will refuse against this partition
# table and which leaves the storage partition out of bounds at runtime.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# BLE provisioning. NimBLE rather than Bluedroid: much smaller, and the
# provisioning component supports both. BLE only - no classic Bluetooth.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# Activation (subsystem A).
#
# CSR writing is behind a Kconfig option. The device generates its own EC P-256
# key and asks the platform to sign it, so without this mbedtls_x509write_csr_*
# simply is not compiled in.
#
# CREATE_C must come with it. MBEDTLS_X509_CSR_WRITE_C is `default y` but
# `depends on MBEDTLS_X509_CREATE_C`, which IDF leaves off - and a Kconfig
# option whose dependency is unmet is dropped SILENTLY. Setting only the line
# below leaves the generated sdkconfig.main-controller with no CSR_WRITE_C
# entry at all and no warning anywhere. Verified by grepping the generated
# file, not by a green build.
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CSR_WRITE_C=y

# Mozilla's root store, shipped with ESP-IDF, used to verify the API host over
# HTTPS. No pinning and no bundle of our own to keep up to date. If the API
# ever moves behind a private CA, this has to be replaced by that CA.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# app_main runs the onboarding loop, and onboarding runs the activation HTTPS
# call on this very task. The default 3584 bytes is not close: measured on
# hardware 2026-09-21, the TLS handshake overflowed it immediately after SNTP
# set the clock -
#
#   I (54277) Activation: clock set to 1789991611
#   ***ERROR*** A stack overflow in task main has been detected.
#
# which rebooted the machine before a single byte reached the platform, and
# looked from the display like activation silently returning to the code
# screen. Subsystem C fetches configuration over the same transport from the
# same task, so this is the app's real requirement, not a patch for one call.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# Two TLS sessions at once. The broker connection is long-lived, and
# config_sync fetches GET /device/configuration over HTTPS while it is up, so
# mbedTLS has to hold two sessions simultaneously. Measured on hardware
# 2026-09-23 with the defaults below unset: the broker connected, the fetch
# then failed every time with
#
#   E esp-tls-mbedtls: mbedtls_ssl_setup returned -0x008D
#
# which is MBEDTLS_ERR_SSL_ALLOC_FAILED - out of heap, not a network or
# certificate problem, though "Connection failed, sock < 0" one line later
# reads exactly like one.
#
# DYNAMIC_BUFFER releases a session's handshake buffers once the handshake is
# done, which is what makes the idle broker session cheap to keep open.
# DYNAMIC_FREE_CA_CERT is deliberately left off: the activation path falls
# back to the Mozilla bundle above, and freeing the parsed CA interacts badly
# with it.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# 16384 is the mbedTLS default and sizes the largest incoming TLS record. The
# certificate chains here are a private PKI's - the device certificate buffer
# is 2 KB and the CA 2.5 KB - and the largest response body is under 1 KB, so
# half of it is still several times what is needed, and it is the single
# biggest per-session allocation.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
