# Production EMQX config rendered from .env.backend.prod (npm run prod:emqx-config)
config/emqx/prod/
# Production TLS certificate and ACME webroot
config/nginx/certs/
config/nginx/acme/

# doxygen output
/docs/api/

# Local CA material exported for the fake-machine smoke test
backend/ca.crt

# Per-deployment trust anchor for the device API. A bench or on-premise
# stack serves its API from a private CA; a production unit must not ship
# trusting one, so this is never committed.
Main-Controller/data/api_ca.pem

# local repo stats
.VSCodeCounter/**
    