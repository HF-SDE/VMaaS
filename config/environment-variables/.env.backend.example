# TimeZone
TZ=Europe/Copenhagen

NODE_ENV=development

DATABASE_URL=postgresql://admin:change-me@db:5432/vmaas
BETTER_AUTH_URL=http://localhost
BETTER_AUTH_SECRET=secret-goes-here
# Comma separated list of allowed browser origins (CORS + Better Auth trusted origins).
FRONTEND_URL=http://localhost,http://localhost:3000

GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>

# Platform super admin created by the seed (prisma db seed / npm run seed).
# Leave both empty to seed permissions only. Password must be at least 8 characters.
# An existing user with this email is promoted; their password is never overwritten.
SEED_ADMIN_EMAIL=admin@vmaas.local
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Super Admin