{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "docker:dev": "docker compose --env-file ../config/environment-variables/.env.backend.dev -f ../docker/docker-compose.yml up -d backend emqx stripe-cli && docker image prune -f",
    "build": "tsc && tsc-alias",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "NODE_ENV=development tsx prisma/seed.dev.ts",
    "postinstall": "prisma skills sync || exit 0",
    "prisma:generate": "prisma generate",
    "pki:init": "tsx tools/pki-init.ts",
    "fake-machine": "tsx tools/fake-machine.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@peculiar/x509": "^2.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@vmaas/shared": "file:../shared",
    "better-auth": "^1.7.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mqtt": "^5.16.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.28.1",
    "stripe": "^22.6.2",
    "undici": "^7.29.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@faker-js/faker": "^10.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "prisma": "^7.10.0",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
