# TimeZone
TZ=Europe/Copenhagen

NODE_ENV=development

DATABASE_URL=postgresql://admin:change-me@db:5432/vmaas
BETTER_AUTH_URL=http://localhost
BETTER_AUTH_SECRET=secret-goes-here
# Comma separated list of allowed browser origins (CORS + Better Auth trusted origins).
FRONTEND_URL=http://localhost,http://localhost:3000

GITHUB_CLIENT_ID=<github-client-id>
GITHUB_CLIENT_SECRET=<github-client-secret>

# Platform super admin created by the seed (prisma db seed / npm run seed).
# Leave both empty to seed permissions only. Password must be at least 8 characters.
# An existing user with this email is promoted; their password is never overwritten.
SEED_ADMIN_EMAIL=admin@vmaas.local
SEED_ADMIN_PASSWORD=change-me-please
SEED_ADMIN_NAME=Super Admin

# Shared secret EMQX sends on its authn/authz webhooks. At least 16 characters.
MQTT_INTERNAL_SECRET=dev-internal-secret-value

# Where the backend connects as a client, and what a machine is told to use.
MQTT_URL=mqtts://emqx:8884
MQTT_PUBLIC_HOST=localhost
MQTT_PUBLIC_PORT=8883
# Must equal the "password" column for vmaas-platform in
# config/emqx/auth-built-in-db-bootstrap.csv.
MQTT_PASSWORD=vmaas-platform-password

# The development CA, written by pki-init into the shared volume.
CA_CERT_PATH=/pki/ca.crt
CA_KEY_PATH=/pki/ca.key

# Certificate and one-time code lifetimes.
DEVICE_CERT_DAYS=90
ACTIVATION_CODE_TTL_MINUTES=60

# EMQX REST API, used to kick a disabled machine's live session.
EMQX_API_URL=http://emqx:18083
EMQX_API_KEY=vmaas-backend
EMQX_API_SECRET=change-me-emqx-secret
# EMQX dashboard admin password. Port 18083 is published to the host, so this
# is a live credential, not a placeholder. Supplied to compose via --env-file
# (root package.json dev scripts) and consumed by the emqx service. Change it.
EMQX_DASHBOARD__DEFAULT_PASSWORD=change-me-emqx-dashboard

# Transactional email (Resend). Both are optional: with no RESEND_API_KEY the
# backend logs invitation emails instead of sending them, so onboarding still
# works end to end without mail credentials. EMAIL_FROM must be an address on a
# domain verified in Resend, or Resend rejects the send.
RESEND_API_KEY=
EMAIL_FROM=no-reply@vmaas.dk

# Public origin used to build links inside emails, e.g. the invitation URL
# ${APP_URL}/invite/<id>. Distinct from FRONTEND_URL, which is a CORS and
# trusted-origin list and may hold several comma-separated entries — a link
# needs exactly one. Defaults to the first FRONTEND_URL entry.
APP_URL=http://localhost:3000


#stripe
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_PRICE_ID_MONTHLY=your-stripe-price-id-for-monthly-plan-here
STRIPE_PRICE_ID_YEARLY=your-stripe-price-id-for-yearly-plan-here

# In dev the `stripe-cli` compose service already forwards Stripe's events to the
# backend; this is the secret it signs them with. Print it once with
# `npm run stripe:secret` and paste it here, then restart the backend — it reads
# the value at import time, so it cannot pick the secret up on its own. The value
# is stable per Stripe account, so this is a one-time step.
# In production it is the endpoint's signing secret from the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret-here
