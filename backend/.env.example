DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/vmaas"
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_SECRET=secret-goes-here

# must match config/emqx/auth-built-in-db-bootstrap.csv (user_id vmaas-platform)
MQTT_PASSWORD=vmaas-platform-password

# must match config/emqx/api_key_bootstrap.txt (key:secret)
EMQX_API_KEY=vmaas-backend
EMQX_API_SECRET=change-me-emqx-secret

# min 16 chars — shared with EMQX's authn/authz webhooks
MQTT_INTERNAL_SECRET=dev-internal-secret-value