DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/vmaas"
BETTER_AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
BETTER_AUTH_SECRET=secret-goes-here

# must match config/emqx/auth-built-in-db-bootstrap.csv (user_id vmaas-platform)
MQTT_PASSWORD=vmaas-platform-password

# must match config/emqx/api_key_bootstrap.txt (key:secret)
EMQX_API_KEY=vmaas-backend
EMQX_API_SECRET=change-me-emqx-secret

# min 16 chars — shared with EMQX's authn/authz webhooks
MQTT_INTERNAL_SECRET=dev-internal-secret-value

# Transactional email (Resend). Both are optional: with no RESEND_API_KEY the
# backend logs invitation emails instead of sending them, so onboarding still
# works end to end without mail credentials. EMAIL_FROM must be an address on a
# domain verified in Resend, or Resend rejects the send.
RESEND_API_KEY=
EMAIL_FROM=no-reply@vmaas.dk

# Public origin used to build links inside emails, e.g. the invitation URL
# ${APP_URL}/invite/<id>. Distinct from FRONTEND_URL, which is a CORS and
# trusted-origin list and may hold several comma-separated entries — a link
# needs exactly one. Defaults to the first FRONTEND_URL entry.
APP_URL=http://localhost:3000
